{
  "name": "dale-compass",
  "version": "1.0.0",
  "description": "大乐罗盘 - A股价值分析系统",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest",
    "lint": "eslint server.js ecosystem.config.js 'services/**/*.js' public/index.html",
    "lint:fix": "eslint --fix server.js ecosystem.config.js 'services/**/*.js' public/index.html",
    "package:deploy": "sh scripts/package-deploy.sh",
    "pm2:start": "npx pm2 start ecosystem.config.js",
    "pm2:restart": "npx pm2 restart dale-compass",
    "pm2:stop": "npx pm2 stop dale-compass",
    "pm2:delete": "npx pm2 delete dale-compass",
    "pm2:status": "npx pm2 status dale-compass",
    "pm2:logs": "npx pm2 logs dale-compass --lines 100",
    "pm2:save": "npx pm2 save"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "iconv-lite": "^0.6.3",
    "node-fetch": "^2.7.0",
    "pm2": "^6.0.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-html": "^8.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
