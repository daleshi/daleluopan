.ring-wrap {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.ring-meta {
  position: absolute;
  bottom: 6%;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring-status {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2430;
}

.ring-label {
  font-size: 22rpx;
  color: #a0a6b8;
  margin-top: 4rpx;
}
